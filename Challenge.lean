module

public import Mathlib.Probability.Distributions.Bernoulli
public import Mathlib.Probability.ProductMeasure
public import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
public import Mathlib.Computability.RE
public import Mathlib.Computability.Partrec
public import Mathlib.Data.Rat.Cast.Order
public import Mathlib.Tactic

/-!
# Kolmogorov–Loveland and Martin-Löf randomness: the advertised statements

This standalone statement surface imports only Mathlib and Lean core. It
spells out the definitions used by the proof rather than importing the local
`Klr` development. The declarations below retain their production names and
bodies, so Comparator can check their meaning against `Solution.lean`.

The convention is total computable adaptive scans with uniformly
computable-real, nonnegative, fair capital. Success means unbounded capital.
No equivalence with a general partial computable-real convention is asserted.
Martin-Löf tests use one actual program for all levels and fair-coin measure.

The two deliberate `sorry`s are Palomar's statement-template holes. They are
isolated from the proved library; `Solution.lean` supplies the actual proofs.
There are no definition holes in `comparator.json`.
-/

@[expose] public section

namespace Klr

open MeasureTheory
open scoped ENNReal NNReal

/-- Infinite binary sequences, with the usual product topology and measure space. -/
abbrev Cantor := ℕ → Bool

/-- The cylinder of all infinite extensions of the finite binary word `s`. -/
def cylinder (s : List Bool) : Set Cantor :=
  {X | ∀ i < s.length, X i = s.getD i false}

/-- A fair probability measure on one bit. -/
noncomputable def fairBit : Measure Bool :=
  ProbabilityTheory.bernoulliMeasure true false ⟨1 / 2, by norm_num, by norm_num⟩

instance : IsProbabilityMeasure fairBit := by
  unfold fairBit
  infer_instance

/-- Independent fair coin tosses at all natural-number positions. -/
noncomputable def fairCoin : Measure Cantor :=
  Measure.infinitePi (fun _ : ℕ => fairBit)

/-- Uniform rational approximation to a real capital function. One computable
function handles every finite history and precision, with error at most `2⁻ⁿ`. -/
def ComputableRealCapital (d : List Bool → ℝ) : Prop :=
  ∃ q : List Bool → ℕ → ℚ,
    Computable (fun p : List Bool × ℕ => ((q p.1 p.2).num, (q p.1 p.2).den)) ∧
    ∀ v n, |(q v n : ℝ) - d v| ≤ (1 / 2 : ℝ) ^ n

/-- A total computable query map. Every query is fresh on every possible
finite answer history; scanning all input positions is not required. -/
structure ScanRule where
  query : List Bool → ℕ
  computable_query : Computable query
  fresh : ∀ (v : List Bool) (n : ℕ), n < v.length → query (v.take n) ≠ query v

namespace ScanRule

/-- The first `n` answers actually observed on input `X` by the adaptive scan. -/
def transcript (π : ScanRule) (X : Cantor) : ℕ → List Bool
  | 0 => []
  | n + 1 =>
    let v := transcript π X n
    v ++ [X (π.query v)]

end ScanRule

/-- A fair nonnegative real capital process, starting at one. -/
structure CapitalProcess where
  value : List Bool → ℝ
  initial : value [] = 1
  nonneg : ∀ v, 0 ≤ value v
  fair : ∀ v, value (v ++ [false]) + value (v ++ [true]) = 2 * value v

/-- A total computable nonmonotonic strategy with uniformly computable real capital. -/
structure BettingStrategy where
  scan : ScanRule
  capital : CapitalProcess
  computable_capital : ComputableRealCapital capital.value

/-- Success is unbounded capital along the observed answers. -/
def BettingStrategy.Succeeds (s : BettingStrategy) (X : Cantor) : Prop :=
  ∀ bound : ℝ, ∃ n, bound < s.capital.value (s.scan.transcript X n)

/-- Randomness against every total computable-real strategy just defined. -/
def KolmogorovLovelandRandom (X : Cantor) : Prop :=
  ∀ s : BettingStrategy, ¬ s.Succeeds X

/-- The open set generated by a predicate on finite binary words. -/
def cylinderUnion (W : List Bool → Prop) : Set Cantor :=
  {X | ∃ s, W s ∧ X ∈ cylinder s}

/-- Membership in the domain of an ordinary partial-recursive program, using
Mathlib's standard encoding. This recognizes a computably enumerable predicate. -/
def programAccepts {α : Type*} [Primcodable α] (c : Nat.Partrec.Code) (a : α) : Prop :=
  (c.eval (Encodable.encode a)).Dom

/-- The `n`th open level enumerated by one program on pairs `(n, s)`.
One code handles all levels, imposing uniform effectiveness. -/
def programOpen (c : Nat.Partrec.Code) (n : ℕ) : Set Cantor :=
  cylinderUnion (fun s => programAccepts c (n, s))

/-- A Martin-Löf test for fair coin. Every level has measure at most `2⁻ⁿ`;
all its cylinders are enumerated by the same partial-recursive code. -/
structure MartinLofTest where
  code : Nat.Partrec.Code
  measure_le : ∀ n, fairCoin (programOpen code n) ≤ (1 / 2 : ℝ≥0∞) ^ n

namespace MartinLofTest

/-- The open set at level `n` of the test. -/
def level (T : MartinLofTest) (n : ℕ) : Set Cantor := programOpen T.code n

/-- A sequence fails a test if it belongs to every level. -/
def Fails (T : MartinLofTest) (X : Cantor) : Prop := ∀ n, X ∈ T.level n

end MartinLofTest

/-- Martin-Löf randomness: passing every uniformly effective fair-coin test. -/
def MartinLofRandom (X : Cantor) : Prop := ∀ T : MartinLofTest, ¬T.Fails X

end Klr

namespace PalomarKlr

/-- There is an infinite binary sequence defeating all total computable-real
Kolmogorov–Loveland strategies but failing a Martin-Löf test. The statement
contains no stage-construction, description, or effectiveness assumption. -/
theorem separation :
    ∃ X : Klr.Cantor,
      Klr.KolmogorovLovelandRandom X ∧ ¬Klr.MartinLofRandom X := by
  sorry

/-- Martin-Löf random sequences form a proper subset of the sequences random
against total computable-real Kolmogorov–Loveland strategies. -/
theorem strict_inclusion :
    {X : Klr.Cantor | Klr.MartinLofRandom X} ⊂
      {X : Klr.Cantor | Klr.KolmogorovLovelandRandom X} := by
  sorry

end PalomarKlr
